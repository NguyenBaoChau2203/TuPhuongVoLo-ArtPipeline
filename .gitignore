*.blend1
*.blend2

# === Maya ===
*.ma~
*.mb~

# === Artist source artwork ===
*.ai
*.ait

# === Logs ===
*.log

# === Temporary ===
*.tmp
*.bak
tests/tmp/

# === AI / dev tooling artifacts (development aids, never production) ===
# CodeGraph generated index/database — development aid only, never commit
.codegraph/
*.codegraph
# Agent long-term memory stores (e.g. TencentDB-Agent-Memory) — evaluation only
.agent_memory/
agent_memory/
memory/
*.memory
*.memory.db
# Vector stores / embeddings / local caches produced by dev or AI tooling
*.vectorstore
vector_store/
vectorstores/
embeddings/
*.embeddings
*.faiss
*.index
.cache/
.agent_cache/

# === Secrets (never commit) ===
.env
.env.*
*.env
secrets/
*.secret
*.key
*.pem
credentials.json
*.credentials

# === Do NOT ignore ===
# !assets/       — source assets are tracked
# !drops/        — drop folder structure is tracked (but contents may be gitignored)
# !config/       — config files are tracked
# !examples/     — example files are tracked
# !tests/in/     — test inputs are tracked
# !tests/out_expected/ — expected outputs are tracked

# Keep empty directories
!assets/refs/.gitkeep
!assets/2d/ai_src/.gitkeep
!assets/2d/svg_raw/.gitkeep
!assets/2d/svg_clean/.gitkeep
!assets/3d/blender/.gitkeep
!assets/3d/maya/.gitkeep
!assets/props_library/.gitkeep
!outputs/svg/.gitkeep
!outputs/png/.gitkeep
!outputs/preview/.gitkeep
!outputs/blender/.gitkeep
!outputs/maya/.gitkeep
!outputs/tmp/.gitkeep
!outputs/manifest/.gitkeep
!drops/.gitkeep
!tests/in/.gitkeep
!tests/out_expected/.gitkeep
